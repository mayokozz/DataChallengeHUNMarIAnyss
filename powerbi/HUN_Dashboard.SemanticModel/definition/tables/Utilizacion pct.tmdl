table 'Utilizacion pct'

	column 'Utilización objetivo (%)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Utilización objetivo (%)]

	partition 'Utilizacion pct' = calculated
		mode: import
		source = SELECTCOLUMNS(GENERATESERIES(50, 100, 5), "Utilización objetivo (%)", [Value])
